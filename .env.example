# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=rudrasports.com,www.rudrasports.com
# Full origins incl. scheme, needed for HTTPS form posts behind a proxy
DJANGO_CSRF_TRUSTED_ORIGINS=https://rudrasports.com,https://www.rudrasports.com
# Canonical public site URL (used for canonical links, sitemap, Open Graph)
SITE_URL=https://rudrasports.com

# Optional: where uploads / collected static files live (defaults: ./media and ./staticfiles)
MEDIA_ROOT=
STATIC_ROOT=
# Set False ONLY while a new domain has no SSL certificate yet
DJANGO_SECURE_COOKIES=True

# --- Database ---
# sqlite (default, local dev) or postgres
DB_ENGINE=sqlite
DB_NAME=rudra_sports
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- HTTPS / production hardening (applied when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
# Set True only if a trusted reverse proxy sets X-Forwarded-Proto
DJANGO_BEHIND_PROXY=False

# --- Email (optional: notify the academy of new enquiries) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
# Sender shown on notification emails (use a mailbox that exists on your domain)
DEFAULT_FROM_EMAIL=info@rudrasports.com
# Comma separated; leave blank to disable notification emails
ENQUIRY_NOTIFY_EMAILS=info@rudrasports.com
